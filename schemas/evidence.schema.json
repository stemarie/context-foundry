{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Context Foundry Evidence Artifact",
  "type": "object",
  "required": ["packet_id", "question", "claims"],
  "properties": {
    "packet_id": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim_id", "claim", "classification", "confidence", "evidence", "limitations"],
        "properties": {
          "claim_id": {"type": "string", "pattern": "^C-[A-Za-z0-9._-]+$"},
          "claim": {"type": "string", "minLength": 1},
          "classification": {"enum": ["fact", "inference", "recommendation", "unknown"]},
          "confidence": {"enum": ["high", "medium", "low"]},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source_id", "location", "excerpt", "observed_at"],
              "properties": {
                "source_id": {"type": "string", "pattern": "^src-[A-Za-z0-9._-]+$"},
                "location": {"type": "string", "minLength": 1},
                "excerpt": {"type": "string", "minLength": 1},
                "observed_at": {"type": "string", "format": "date-time"}
              },
              "additionalProperties": false
            }
          },
          "limitations": {"type": "array", "items": {"type": "string"}},
          "next_action": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
